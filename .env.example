# Copie este arquivo para .env e preencha (Supabase > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- SOMENTE NA VERCEL (Settings > Environment Variables). NUNCA use prefixo VITE_ nestas ----
# MP_ACCESS_TOKEN=            (Mercado Pago > Suas integrações > Credenciais de teste > Access Token)
# SUPABASE_SERVICE_ROLE_KEY=  (Supabase > Project Settings > API > service_role / secret)
# MP_PIX_TEST=true            (SÓ em teste: o Pix é aprovado automaticamente. Remova em produção)
# SITE_URL=https://seu-site.vercel.app   (opcional)
